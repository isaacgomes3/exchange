# Supabase — https://supabase.com/dashboard/project/wknyfxikmmvjzpbevlid
NEXT_PUBLIC_SUPABASE_URL=https://wknyfxikmmvjzpbevlid.supabase.co
# Publishable key (Settings → API Keys) ou anon JWT legado
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Opcional (somente servidor; nunca exponha no cliente)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# BetBra / Mexchange
MEXCHANGE_API_BASE_URL=https://mexchange-api.betbra.bet.br/api
EXCHANGE_SITE_ORIGIN=https://betbra.bet.br
MEXCHANGE_REFERER=https://mexchange.betbra.bet.br/
MEXCHANGE_BOT_USER_AGENT=BOT/SOFTWARE;Arbitrex;1.0
MEXCHANGE_BIAB_LANGUAGE=PT_BR
MEXCHANGE_INPLAY_FEED_URL=https://betbra.bet.br/client/api/jumper/feedSports/inplay-info
FULLTBET_SOCCER_SPORT_ID=15
FULLTBET_TENNIS_SPORT_ID=9

# Rate limit / polling
MEXCHANGE_REQUEST_SPACING_MS=200
MEXCHANGE_EVENTS_PER_PAGE=50
MEXCHANGE_POLL_INTERVAL_MS=10000

# Proxy local — usa o IP da SUA máquina (Brasil)
# Se estiver no Brasil, pode desativar e chamar a BetBra direto:
MEXCHANGE_USE_LOCAL_PROXY=0
# MEXCHANGE_USE_LOCAL_PROXY=1
# MEXCHANGE_LOCAL_PROXY_URL=http://127.0.0.1:8787
# BETBRA_PROXY_PORT=8787
