[Unit]
Description=ArbiShield TanStack /_serverFn shim (VPS static frontend)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/arbishield
EnvironmentFile=-/opt/arbishield/deploy/vps-supabase/.env
EnvironmentFile=-/opt/arbishield/.arbishield-odds-sync.env
Environment=SERVERFN_LISTEN=127.0.0.1:3101
Environment=ARBISHIELD_SUPABASE_URL=http://127.0.0.1:8000
ExecStart=/usr/bin/node /opt/arbishield/scripts/arbishield-serverfn-shim.mjs
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
