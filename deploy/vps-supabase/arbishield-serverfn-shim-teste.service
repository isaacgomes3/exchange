[Unit]
Description=ArbiShield TESTE serverFn shim :3201
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/arbishield-teste
EnvironmentFile=-/opt/arbishield/deploy/vps-supabase/.env
EnvironmentFile=-/opt/arbishield/.arbishield-odds-sync.env
EnvironmentFile=-/opt/arbishield-teste/.env
Environment=ARBISHIELD_ENV=teste
Environment=ARBISHIELD_SITE=teste
Environment=SERVERFN_LISTEN=127.0.0.1:3201
Environment=ARBISHIELD_SUPABASE_URL=http://127.0.0.1:8000
ExecStart=/usr/bin/node /opt/arbishield-teste/scripts/arbishield-serverfn-shim.mjs
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
